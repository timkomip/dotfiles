#!/usr/bin/env zsh

function is_macos() {
  [[ "$(uname)" == "Darwin" ]]
}

function is_linux() {
  [[ "$(uname)" == "Linux" ]]
}

function has_apt() {
  command -v apt-get &>/dev/null
}

# Ensure Linux install locations are on PATH for every subcommand. snap puts
# binaries in /snap/bin and mise's installer uses ~/.local/bin; without these,
# tools like yq won't be found by sync_links even right after installing them.
function ensure_linux_path() {
  is_linux || return 0
  local dir
  for dir in /snap/bin "$HOME/.local/bin"; do
    [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]] && export PATH="$PATH:$dir"
  done
}

function show_help() {
  cat <<EOF
dotty - Manage dotfiles

USAGE:
    dotty [COMMAND]

COMMANDS:
    init        Initialize dotfiles (zshrc, oh-my-zsh, packages, links)
    packages    Install packages (Homebrew on macOS, apt/snap on Ubuntu)
    brew        Install Homebrew and packages from Brewfile (macOS)
    links       Create symlinks from links.yml
    help        Show this help message

For more information, visit: ~/dotfiles
EOF
}

# Print an overview of what `dotty init` is about to do. This is purely
# informational; the actual work happens in the steps that follow.
function init_dotfiles() {
  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  echo "Initializing dotfiles from: $dotfiles_dir"
  echo ""
  echo "init will:"
  echo "  - install packages for this OS"
  echo "  - install oh-my-zsh (if missing)"
  echo "  - clone vendor dependencies into vendor/"
  echo "  - create symlinks from config/links.yml"
  echo ""
  echo "Existing files in the way of a symlink are moved to"
  echo "~/.dotfiles-backup/<timestamp>/ rather than overwritten."
}

function init_brew() {
  if ! is_macos; then
    echo "Warning: Homebrew is only available on macOS. Skipping brew installation." >&2
    echo "Linux support may be added in the future." >&2
    return 0
  fi

  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  local brewfile="$dotfiles_dir/config/Brewfile"

  # Check if Homebrew is installed
  if ! command -v brew &>/dev/null; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    
    # Add Homebrew to PATH for Apple Silicon Macs
    if [[ -f "/opt/homebrew/bin/brew" ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f "/usr/local/bin/brew" ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
  else
    echo "Homebrew is already installed"
  fi

  # Install packages from Brewfile
  if [ -f "$brewfile" ]; then
    echo "Installing packages from Brewfile..."
    brew bundle --file="$brewfile"
  else
    echo "Warning: Brewfile not found at $brewfile" >&2
  fi
}

function init_apt() {
  if ! has_apt; then
    echo "Warning: apt-get not found. This Linux branch targets Debian/Ubuntu." >&2
    return 0
  fi

  # Packages available directly from apt
  local apt_packages=(git fzf htop bat jq)

  echo "Updating apt package lists..."
  sudo apt-get update

  echo "Installing apt packages..."
  local pkg
  for pkg in "${apt_packages[@]}"; do
    if sudo apt-get install -y "$pkg"; then
      echo "  ✓ $pkg"
    else
      echo "  ⚠ Failed to install $pkg via apt" >&2
    fi
  done

  # On Debian/Ubuntu the bat binary is installed as "batcat" to avoid a name
  # clash. Expose it as "bat" in ~/.local/bin so configs and aliases that call
  # "bat" work the same as on macOS (where Homebrew installs it as "bat").
  if command -v batcat &>/dev/null && ! command -v bat &>/dev/null; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
    ensure_linux_path
    echo "  ✓ linked bat -> batcat in ~/.local/bin"
  fi
}

function init_snap() {
  if ! command -v snap &>/dev/null; then
    echo "Warning: snap not available; skipping yq, gh, lazygit." >&2
    echo "Install snapd (sudo apt-get install -y snapd) and re-run 'dotty packages'." >&2
    return 0
  fi

  # apt's "yq" is a different (python) tool, so we use snap to get mikefarah's
  # yq that the rest of dotty expects. gh and lazygit aren't in apt by default.
  echo "Installing snap packages..."
  local pkg
  for pkg in yq gh lazygit; do
    if sudo snap install "$pkg"; then
      echo "  ✓ $pkg"
    else
      echo "  ⚠ Failed to install $pkg via snap" >&2
    fi
  done

  # /snap/bin now exists; make sure freshly installed tools (e.g. yq) are found
  ensure_linux_path
}

function init_mise() {
  # mise isn't reliably packaged in apt or snap, so use its official installer.
  if command -v mise &>/dev/null; then
    echo "mise is already installed"
    return 0
  fi

  echo "Installing mise..."
  curl -fsSL https://mise.run | sh || echo "  ⚠ Failed to install mise" >&2
}

function init_linux_packages() {
  if ! has_apt; then
    echo "Warning: apt-get not found. This Linux branch targets Debian/Ubuntu." >&2
    return 0
  fi

  init_apt
  init_snap
  init_mise
}

# Install packages using the right package manager for the current OS.
function init_packages() {
  if is_macos; then
    init_brew
  elif is_linux; then
    init_linux_packages
  else
    echo "Warning: Unsupported OS '$(uname)'. Skipping package installation." >&2
  fi
}

function init_ohmyzsh() {
  local ohmyzsh_dir="$HOME/.oh-my-zsh"

  # Check if oh-my-zsh is already installed
  if [ -d "$ohmyzsh_dir" ]; then
    echo "oh-my-zsh is already installed at $ohmyzsh_dir"
    return 0
  fi

  # Install oh-my-zsh
  echo "Installing oh-my-zsh..."
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended --keep-zshrc
  
  # Verify installation
  if [ -d "$ohmyzsh_dir" ]; then
    echo "oh-my-zsh installed successfully"
  else
    echo "Warning: oh-my-zsh installation may have failed" >&2
    return 1
  fi
}

function git_clone_vendor() {
  local repo_url="$1"
  local dir_name="$2"
  
  if [ -z "$repo_url" ] || [ -z "$dir_name" ]; then
    echo "Error: git_clone_vendor requires a repository URL and directory name" >&2
    return 1
  fi

  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  local vendor_dir="$dotfiles_dir/vendor"
  local repo_dir="$vendor_dir/$dir_name"

  # Check if git is installed
  if ! command -v git &>/dev/null; then
    echo "Warning: git is required to clone $dir_name. Skipping..." >&2
    return 1
  fi

  # Create vendor directory if it doesn't exist
  if [ ! -d "$vendor_dir" ]; then
    mkdir -p "$vendor_dir"
  fi

  # Check if repo is already cloned
  if [ -d "$repo_dir" ]; then
    echo "$dir_name is already cloned at $repo_dir"
    return 0
  fi

  # Clone the repository
  echo "Cloning $dir_name into vendor directory..."
  if git clone "$repo_url" "$repo_dir"; then
    echo "✓ $dir_name cloned successfully"
  else
    echo "Warning: Failed to clone $dir_name" >&2
    return 1
  fi
}

function init_vendor() {
  git_clone_vendor "https://github.com/junegunn/fzf-git.sh" "fzf-git.sh"
}

function sync_links() {
  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  local links_file="$dotfiles_dir/config/links.yml"

  # Check if yq is installed
  if ! command -v yq &>/dev/null; then
    echo "Error: yq is required but not installed. Run 'dotty packages' first." >&2
    exit 1
  fi

  # Check if links.yml exists
  if [ ! -f "$links_file" ]; then
    echo "Warning: links.yml not found at $links_file" >&2
    return 1
  fi

  # Parse YAML and create symlinks. yq returns "null" (not 0) when there's no
  # links key, so guard against a non-numeric count before comparing it.
  local count=$(yq '.links | length' "$links_file")

  if ! [[ "$count" =~ ^[0-9]+$ ]] || [ "$count" -eq 0 ]; then
    echo "No links found in $links_file"
    return 0
  fi

  echo "Creating symlinks from $links_file..."

  for ((i=0; i<count; i++)); do
    local from=$(yq -r ".links[$i].from" "$links_file")
    local to=$(yq -r ".links[$i].to" "$links_file")

    # Expand ~ to $HOME
    from="${from/#\~/$HOME}"
    to="${to/#\~/$HOME}"

    # Check if source exists
    if [ ! -e "$from" ]; then
      echo "Warning: Source does not exist: $from" >&2
      continue
    fi

    # Check if destination already exists
    if [ -e "$to" ] || [ -L "$to" ]; then
      if [ -L "$to" ]; then
        local current_target=$(readlink "$to")
        if [ "$current_target" = "$from" ]; then
          echo "  ✓ Symlink already exists: $to -> $from"
          continue
        fi
      fi

      # Something is in the way (a real file, or a symlink pointing
      # elsewhere). Don't destroy it: move it into a timestamped backup
      # dir so it's recoverable, then fall through to create the symlink.
      local backup_dir="$HOME/.dotfiles-backup/$DOTTY_RUN_STAMP"
      mkdir -p "$backup_dir"
      local backup_path="$backup_dir/$(basename "$to")"
      mv "$to" "$backup_path"
      echo "  ↻ Backed up existing $to -> $backup_path"
    fi

    # Create parent directory if needed
    local to_dir=$(dirname "$to")
    if [ ! -d "$to_dir" ]; then
      mkdir -p "$to_dir"
    fi

    # Create symlink
    ln -s "$from" "$to"
    echo "  ✓ Created symlink: $to -> $from"
  done
}

function print_section() {
  local title="$1"
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  $title"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
}

function init() {
  print_section "STEP 1: Initialize Dotfiles Configuration"
  init_dotfiles
  
  print_section "STEP 2: Install Packages"
  init_packages

  print_section "STEP 3: Install oh-my-zsh"
  init_ohmyzsh

  print_section "STEP 4: Clone Vendor Dependencies"
  init_vendor
  
  print_section "STEP 5: Create Symlinks"
  sync_links
  
  print_section "✓ Initialization complete!"
}

# Main command handler
ensure_linux_path

# One backup folder per invocation, shared by every link that needs to
# displace an existing file (see sync_links).
export DOTTY_RUN_STAMP="$(date +%Y%m%d-%H%M%S)"

case "${1:-help}" in
  init)
    init
    ;;
  packages)
    init_packages
    ;;
  brew)
    init_brew
    ;;
  links)
    sync_links
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo "Error: Unknown command '$1'"
    echo ""
    show_help
    exit 1
    ;;
esac

