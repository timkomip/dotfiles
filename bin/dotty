#!/usr/bin/env zsh

function is_macos() {
  [[ "$(uname)" == "Darwin" ]]
}

function is_linux() {
  [[ "$(uname)" == "Linux" ]]
}

function has_apt() {
  command -v apt-get &>/dev/null
}

# Ensure Linux install locations are on PATH for every subcommand. snap puts
# binaries in /snap/bin and mise's installer uses ~/.local/bin; without these,
# tools like yq won't be found by sync_links even right after installing them.
function ensure_linux_path() {
  is_linux || return 0
  local dir
  for dir in /snap/bin "$HOME/.local/bin"; do
    [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]] && export PATH="$PATH:$dir"
  done
}

function show_help() {
  cat <<EOF
dotty - Manage dotfiles

USAGE:
    dotty [COMMAND]

COMMANDS:
    init        Initialize dotfiles (zshrc, oh-my-zsh, packages, links)
    packages    Install packages (Homebrew on macOS, apt/snap on Ubuntu)
    brew        Install Homebrew and the mac_brew packages (macOS)
    links       Create symlinks from links.conf (--dry-run to preview)
    help        Show this help message

For more information, visit: ~/dotfiles
EOF
}

# Print an overview of what `dotty init` is about to do. This is purely
# informational; the actual work happens in the steps that follow.
function init_dotfiles() {
  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  echo "Initializing dotfiles from: $dotfiles_dir"
  echo ""
  echo "init will:"
  echo "  - install packages for this OS"
  echo "  - install oh-my-zsh (if missing)"
  echo "  - clone vendor dependencies into vendor/"
  echo "  - create symlinks from config/links.conf"
  echo ""
  echo "Existing files in the way of a symlink are moved to"
  echo "~/.dotfiles-backup/<timestamp>/ rather than overwritten."
}

# Install Homebrew (if needed) and the brew packages from packages.conf. The
# package list is selected by token (defaults to "mac_brew"; see packages.conf).
function init_brew() {
  local token="${1:-mac_brew}"

  if ! is_macos; then
    echo "Warning: Homebrew is only available on macOS. Skipping brew installation." >&2
    echo "Linux support may be added in the future." >&2
    return 0
  fi

  # Check if Homebrew is installed
  if ! command -v brew &>/dev/null; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Add Homebrew to PATH for Apple Silicon Macs
    if [[ -f "/opt/homebrew/bin/brew" ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f "/usr/local/bin/brew" ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
  else
    echo "Homebrew is already installed"
  fi

  echo "Installing brew packages..."
  local entry args name
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    args=(${=entry}); name="${args[1]}"   # split "<package> [flags...]"
    if brew install "${args[@]}"; then
      echo "  ✓ $name"
    else
      echo "  ⚠ Failed to install $name via brew" >&2
    fi
  done < <(parse_packages "$token")
}

# Install the apt packages from packages.conf (token defaults to "apt").
function init_apt() {
  local token="${1:-apt}"

  if ! has_apt; then
    echo "Warning: apt-get not found. This Linux branch targets Debian/Ubuntu." >&2
    return 0
  fi

  # Each entry is "<package> [flags...]" (see parse_packages)
  local apt_entries=("${(@f)$(parse_packages "$token")}")
  if [[ ${#apt_entries[@]} -eq 0 ]]; then
    echo "No apt packages listed in packages.conf."
    return 0
  fi

  echo "Updating apt package lists..."
  sudo apt-get update

  echo "Installing apt packages..."
  local entry args name
  for entry in "${apt_entries[@]}"; do
    [[ -z "$entry" ]] && continue
    args=(${=entry}); name="${args[1]}"
    if sudo apt-get install -y "${args[@]}"; then
      echo "  ✓ $name"
    else
      echo "  ⚠ Failed to install $name via apt" >&2
    fi
  done
}

# Install the snap packages from packages.conf (token defaults to "snap").
function init_snap() {
  local token="${1:-snap}"

  if ! command -v snap &>/dev/null; then
    echo "Warning: snap not available; skipping snap packages." >&2
    echo "Install snapd (sudo apt-get install -y snapd) and re-run 'dotty packages'." >&2
    return 0
  fi

  # apt's "yq" is a different (python) tool, so we use snap to get mikefarah's
  # yq that the rest of dotty expects. gh and lazygit aren't in apt by default.
  echo "Installing snap packages..."
  local entry args name
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    args=(${=entry}); name="${args[1]}"   # e.g. "nvim --classic"
    if sudo snap install "${args[@]}"; then
      echo "  ✓ $name"
    else
      echo "  ⚠ Failed to install $name via snap" >&2
    fi
  done < <(parse_packages "$token")

  # /snap/bin now exists; make sure freshly installed tools (e.g. yq) are found
  ensure_linux_path
}

# Echo the install entries for an exact manager TOKEN (e.g. "apt" or "mac_brew")
# from config/packages.conf, one per line. Each entry is the package name plus
# any trailing flags/args to pass to the install command, e.g. "nvim --classic".
# Parsed with shell built-ins (no yq), the same way sync_links reads links.conf.
function parse_packages() {
  local want="$1"
  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  local file="$dotfiles_dir/config/packages.conf"
  if [ ! -f "$file" ]; then
    echo "Warning: packages.conf not found at $file" >&2
    return 1
  fi

  local line mgr rest trimmed
  while IFS= read -r line; do
    # Skip blank lines and comments (ignoring any leading whitespace)
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue

    # First field is the manager; the rest is "<package> [flags...]"
    read -r mgr rest <<< "$line"
    [[ -z "$mgr" || -z "$rest" ]] && continue
    [[ "$mgr" == "$want" ]] && echo "$rest"
  done < "$file"
}

# Echo each distinct manager token used in packages.conf, in first-seen order.
function list_package_tokens() {
  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  local file="$dotfiles_dir/config/packages.conf"
  if [ ! -f "$file" ]; then
    echo "Warning: packages.conf not found at $file" >&2
    return 1
  fi

  local line mgr pkg trimmed
  typeset -A seen
  while IFS= read -r line; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue

    read -r mgr pkg <<< "$line"
    [[ -z "$mgr" || -z "$pkg" || -n "${seen[$mgr]}" ]] && continue
    seen[$mgr]=1
    echo "$mgr"
  done < "$file"
}

# Echo "mac" or "linux" for the current OS (empty for anything else).
function current_os_tag() {
  if is_macos; then
    echo mac
  elif is_linux; then
    echo linux
  fi
}

# Install every package in config/packages.conf, then run custom-installs.zsh.
#
# Each line's manager token may carry an optional OS prefix:
#   mac_<mgr>/linux_<mgr> run only on that OS; bare <mgr> runs wherever the
#   manager's command is available (each init_* keeps its own availability
#   guard). Tools not in a package manager live in config/custom-installs.zsh.
function init_packages() {
  local os_tag
  os_tag="$(current_os_tag)"

  local token mgr os
  for token in ${(@f)"$(list_package_tokens)"}; do
    mgr="$token"
    os=""
    if [[ "$token" == (mac|linux)_* ]]; then
      os="${token%%_*}"
      mgr="${token#*_}"
      if [[ "$os" != "$os_tag" ]]; then
        echo "Skipping $token (only on $os)"
        continue
      fi
    fi

    case "$mgr" in
      brew) init_brew "$token" ;;
      apt)  init_apt  "$token" ;;
      snap) init_snap "$token" ;;
      *)    echo "Warning: unknown package manager '$mgr' in packages.conf" >&2 ;;
    esac
  done

  # Tools not in a package manager (mise, bat shim). Runs on every OS; each
  # function in custom-installs.zsh does its own platform check.
  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  [ -f "$dotfiles_dir/config/custom-installs.zsh" ] && source "$dotfiles_dir/config/custom-installs.zsh"
  typeset -f custom_installs >/dev/null && custom_installs
}

function init_ohmyzsh() {
  local ohmyzsh_dir="$HOME/.oh-my-zsh"

  # Check if oh-my-zsh is already installed
  if [ -d "$ohmyzsh_dir" ]; then
    echo "oh-my-zsh is already installed at $ohmyzsh_dir"
    return 0
  fi

  # Install oh-my-zsh
  echo "Installing oh-my-zsh..."
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended --keep-zshrc
  
  # Verify installation
  if [ -d "$ohmyzsh_dir" ]; then
    echo "oh-my-zsh installed successfully"
  else
    echo "Warning: oh-my-zsh installation may have failed" >&2
    return 1
  fi
}

function git_clone_vendor() {
  local repo_url="$1"
  local dir_name="$2"
  
  if [ -z "$repo_url" ] || [ -z "$dir_name" ]; then
    echo "Error: git_clone_vendor requires a repository URL and directory name" >&2
    return 1
  fi

  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  local vendor_dir="$dotfiles_dir/vendor"
  local repo_dir="$vendor_dir/$dir_name"

  # Check if git is installed
  if ! command -v git &>/dev/null; then
    echo "Warning: git is required to clone $dir_name. Skipping..." >&2
    return 1
  fi

  # Create vendor directory if it doesn't exist
  if [ ! -d "$vendor_dir" ]; then
    mkdir -p "$vendor_dir"
  fi

  # Check if repo is already cloned
  if [ -d "$repo_dir" ]; then
    echo "$dir_name is already cloned at $repo_dir"
    return 0
  fi

  # Clone the repository
  echo "Cloning $dir_name into vendor directory..."
  if git clone "$repo_url" "$repo_dir"; then
    echo "✓ $dir_name cloned successfully"
  else
    echo "Warning: Failed to clone $dir_name" >&2
    return 1
  fi
}

function init_vendor() {
  git_clone_vendor "https://github.com/junegunn/fzf-git.sh" "fzf-git.sh"
}

# Create symlinks defined in config/links.conf. Pass --dry-run (or -n) to
# print what would happen without touching the filesystem. The config is a
# plain two-column file (<source> <destination>); see config/links.conf.
# Using a flat file keeps sync_links dependency-free (no yq).
function sync_links() {
  local dry_run=0
  local arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run|-n) dry_run=1 ;;
    esac
  done

  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  local links_file="$dotfiles_dir/config/links.conf"

  # Check if links.conf exists
  if [ ! -f "$links_file" ]; then
    echo "Warning: links.conf not found at $links_file" >&2
    return 1
  fi

  if [ "$dry_run" -eq 1 ]; then
    echo "Dry run: no files will be created, moved, or deleted."
  fi
  echo "Creating symlinks from $links_file..."

  local line from to trimmed
  while IFS= read -r line; do
    # Skip blank lines and comments (ignoring any leading whitespace)
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue

    # Split the line into two whitespace-separated fields
    read -r from to <<< "$line"
    if [[ -z "$from" || -z "$to" ]]; then
      echo "  ⚠ Skipping malformed line: $line" >&2
      continue
    fi

    # Source is relative to the repo root; destination may use a leading ~
    from="$dotfiles_dir/$from"
    to="${to/#\~/$HOME}"

    # Check if source exists
    if [ ! -e "$from" ]; then
      echo "Warning: Source does not exist: $from" >&2
      continue
    fi

    # Check if destination already exists
    if [ -e "$to" ] || [ -L "$to" ]; then
      if [ -L "$to" ]; then
        local current_target=$(readlink "$to")
        if [ "$current_target" = "$from" ]; then
          echo "  ✓ Symlink already exists: $to -> $from"
          continue
        fi
      fi

      # Something is in the way (a real file, or a symlink pointing
      # elsewhere). Don't destroy it: move it into a timestamped backup
      # dir so it's recoverable, then fall through to create the symlink.
      local backup_dir="$HOME/.dotfiles-backup/$DOTTY_RUN_STAMP"
      local backup_path="$backup_dir/$(basename "$to")"
      if [ "$dry_run" -eq 1 ]; then
        echo "  ↻ [dry-run] would back up existing $to -> $backup_path"
      else
        mkdir -p "$backup_dir"
        mv "$to" "$backup_path"
        echo "  ↻ Backed up existing $to -> $backup_path"
      fi
    fi

    if [ "$dry_run" -eq 1 ]; then
      echo "  ✓ [dry-run] would create symlink: $to -> $from"
      continue
    fi

    # Create parent directory if needed
    local to_dir=$(dirname "$to")
    if [ ! -d "$to_dir" ]; then
      mkdir -p "$to_dir"
    fi

    # Create symlink
    ln -s "$from" "$to"
    echo "  ✓ Created symlink: $to -> $from"
  done < "$links_file"
}

function print_section() {
  local title="$1"
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  $title"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
}

function init() {
  print_section "STEP 1: Initialize Dotfiles Configuration"
  init_dotfiles
  
  print_section "STEP 2: Install Packages"
  init_packages

  print_section "STEP 3: Install oh-my-zsh"
  init_ohmyzsh

  print_section "STEP 4: Clone Vendor Dependencies"
  init_vendor
  
  print_section "STEP 5: Create Symlinks"
  sync_links
  
  print_section "✓ Initialization complete!"
}

# Main command handler
ensure_linux_path

# One backup folder per invocation, shared by every link that needs to
# displace an existing file (see sync_links).
export DOTTY_RUN_STAMP="$(date +%Y%m%d-%H%M%S)"

case "${1:-help}" in
  init)
    init
    ;;
  packages)
    init_packages
    ;;
  brew)
    init_brew
    ;;
  links)
    sync_links "${@:2}"
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo "Error: Unknown command '$1'"
    echo ""
    show_help
    exit 1
    ;;
esac

